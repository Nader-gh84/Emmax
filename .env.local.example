# Supabase — add these to .env.local

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — required for public quote confirmation API
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — required for voice transcription and quote extraction
OPENAI_API_KEY=your-openai-api-key

# Resend — required for sending quote emails
RESEND_API_KEY=your-resend-api-key

# Optional: production site URL for quote confirmation links in emails
# NEXT_PUBLIC_SITE_URL=https://emmax-six.vercel.app
# RESEND_FROM_EMAIL=EmaX <quotes@yourdomain.com>
