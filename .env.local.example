# Supabase — add these to .env.local

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI — required for voice transcription and quote extraction
OPENAI_API_KEY=your-openai-api-key

# Resend — required for sending quote emails
RESEND_API_KEY=your-resend-api-key

# Optional: verified sender address (defaults to onboarding@resend.dev for testing)
# RESEND_FROM_EMAIL=EmaX <quotes@yourdomain.com>
